[alias]
	co = checkout
	lg = log --oneline --graph --all --decorate
	lo = pull origin
	lom = pull origin
	lr = pull --rebase
	po = push origin
	pom = push origin master
	sm = submodule update --init --recursive
	ss = status
	st = stash
	stp = stash pop

[color "branch"]
	current = cyan reverse
	local = green
	remote = cyan

[color "status"]
	added = green
	changed = yellow
	untracked = cyan

[core]
	editor = vim

[merge]
	tool = meld
	conflictstyle = diff3

[color]
	ui = auto

[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold
	whitespace = red reverse

[diff]
	algorithm = histogram
	colorMoved = default

[include]
	path = ~/.gitconfig_local
